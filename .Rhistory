manual_pipeline <- function(data, var_names, to = "MM") {
## Step 1: manual format identification (user inspects columns)
fmt <- NULL
if (inherits(data, "symbolic_tbl") && any(sapply(data, mode) == "complex")) {
fmt <- "RSDA"
} else if (is.data.frame(data)) {
cn <- names(data)
if (any(grepl("_min|_Min", cn)) && any(grepl("_max|_Max", cn))) {
fmt <- "MM"
} else {
char_cols <- which(sapply(data, is.character))
if (length(char_cols) > 0) {
vals <- as.character(data[[char_cols[1]]][1])
if (grepl("^[0-9.-]+,[0-9.-]+$", vals)) fmt <- "iGAP"
}
}
}
if (is.null(fmt)) stop("Could not detect format manually")
## Step 2: call specific conversion function
if (fmt == "RSDA" && to == "MM") {
data_mm <- RSDA_to_MM(data)
} else if (fmt == "iGAP" && to == "MM") {
data_mm <- iGAP_to_MM(data)
} else if (fmt == "MM") {
data_mm <- data
} else {
stop("Unsupported manual conversion: ", fmt, " -> ", to)
}
## Step 3: compute statistics individually
results <- list()
for (v in var_names) {
results[[paste0(v, "_mean")]] <- int_mean(data_mm, v, method = "CM")
results[[paste0(v, "_var")]]  <- int_var(data_mm,  v, method = "CM")
}
## Step 4: compute distance matrix
d <- int_dist(data_mm, method = "euclidean")
invisible(list(data_mm = data_mm, stats = results, dist = d))
}
